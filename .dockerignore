.git/
.github/
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.env
app.db
# Спутники WAL — та же причина, что в .gitignore (задача 105).
app.db-wal
app.db-shm

# Файлы пользователей — та же причина, что и в .gitignore, но утечка другая:
# образ уезжает в реестр. Локально каталоги лежат в корне репозитория
# (AVATAR_DIR и MEDIA_ROOT считаются от dirname(DB_PATH)), и без этих строк
# всё, что накопилось при локальной проверке, запеклось бы в образ.
# На проде они живут на томе и в сборку не попадают в принципе.
avatars/
media/

# Кадры видео упражнений — кеш фасада, наполняется на проде на томе.
# Без этой строки всё, что накопилось при локальной проверке,
# запеклось бы в образ (BACKLOG №73).
previews/

# КАРТИНКИ СЕТОВ, ЗАГРУЖЕННЫЕ ЭКРАНОМ УПРАВЛЕНИЯ (BACKLOG №137).
# Тот же расчёт каталога от dirname(DB_PATH): на проде /data/enshrouded,
# локально прямо здесь. В репозиторий не идут по той же причине, что
# previews/ — это правки содержимого, сделанные на живом сервере, а
# не исходный код. СЕМЯ каталога (static/enshrouded/, 90 файлов) в git
# остаётся: оно едет в образ и наполняет пустую установку.
/enshrouded/

server.log
server.err
ssh_*.py
*.md
!TRAINER_PROMPT.md

# Снимки справочника упражнений. На машине им делать нечего: восстановление
# идёт с локального компьютера, а лишняя копия рядом с exercises_seed.json —
# это ровно та путаница, ради устранения которой seed и переименовали.
# Плюс каждый снимок ~2 МБ, и они копятся
backups/

# КЕШ СТРАНИЦ СПРАВОЧНИКА (`MEDKIT_CACHE`, по умолчанию .dosage_cache).
# Заведён задачей 199 для `check_medkit_all.py` и НЕ БЫЛ ВНЕСЁН СЮДА:
# замер 2026-08-29 нашёл 68 файлов, лежащих без присмотра. Внутри —
# страницы препаратов ИЗ АПТЕЧКИ ЖИВОГО ЧЕЛОВЕКА, то есть названия
# лекарств, то есть сведения о здоровье (§5.1), а репозиторий
# публичный. Одного `git add -A` хватило бы, чтобы они уехали
# в историю навсегда — ровно та ловушка, на которой однажды
# попались спутники базы `app.db-wal` и `app.db-shm`.
.dosage_cache/

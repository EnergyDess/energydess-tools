# СЕКРЕТЫ. Правило по КЛАССУ имени, а не по одному имени: строка `.env`
# закрывала ровно её саму, и `.env.local` прошёл бы в публичную историю
# молча — замер 2026-08-20 через git check-ignore это и показал.
.env*
!.env.example

# БАЗА И ЕЁ СПУТНИКИ. С задачи 105 журнал у SQLite — WAL, и рядом с app.db
# лежат ещё два файла. В них те же пользовательские данные, что и в самой
# базе. Строки `app.db` для них НЕ ХВАТАЕТ — имя другое, и `git add -A`
# утащил бы их в публичную историю (поймано 2026-08-20 прямо на индексе;
# в историю они НЕ уехали — блобы остались висячими, ни в одном дереве).
# По классу, а не по трём именам, по той же причине, что и секреты: копия
# базы под другим именем (app.db.bak, dump.sqlite3) проходила бы мимо,
# а проверка продолжала бы печатать «чисто» — §6.0.1, немой отказ.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# КЛЮЧИ И СЕРТИФИКАТЫ
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ФАЙЛЫ ПОЛЬЗОВАТЕЛЕЙ. Оба каталога создаются приложением рядом с базой
# (main.py: AVATAR_DIR и MEDIA_ROOT считаются от dirname(DB_PATH)), поэтому
# на проде это /data/avatars и /data/media, а локально — прямо здесь,
# в корне репозитория. Репозиторий публичный, и один `git add .` отправил
# бы чужое лицо в открытую историю необратимо: удалить оттуда файл можно
# только переписав историю всем, кто её клонировал.
#   avatars/     — <user_id>.png
#   media/chat/  — картинки из переписки с ассистентами
#   media/body/  — фотографии прогресса тела
avatars/
media/

# КАДРЫ ВИДЕО УПРАЖНЕНИЙ — кеш фасада (BACKLOG №73). Тот же расчёт
# каталога от dirname(DB_PATH), то есть локально прямо здесь.
# Причина иная, чем у файлов пользователей: это ЧУЖИЕ изображения,
# их 852 по числу роликов, и репозиторий публичный. На проде лежат
# на томе, переживают деплой и в образ не попадают.
previews/

__pycache__/
*.pyc
*.pyo
venv/
.venv/
server.log
server.err
# SSH-утилиты (локальные, не в репу)
ssh_*.py

# Все логи
*.log

# Временные файлы Windows
C*Temp*
*Temp*.log

# Backup-файлы
*.old
*.bak

# Скриншоты ревью дизайн-миграции (локальные, не в репу)
review_screenshots/
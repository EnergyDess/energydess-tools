.env
app.db
# СПУТНИКИ БАЗЫ. С задачи 105 журнал у SQLite — WAL, и рядом с app.db
# лежат ещё два файла. В них те же пользовательские данные, что
# и в самой базе. Строки `app.db` для них НЕ ХВАТАЕТ — имя другое,
# и `git add -A` утащил бы их в публичную историю (поймано
# 2026-08-20 прямо на индексе).
app.db-wal
app.db-shm

# ФАЙЛЫ ПОЛЬЗОВАТЕЛЕЙ. Оба каталога создаются приложением рядом с базой
# (main.py: AVATAR_DIR и MEDIA_ROOT считаются от dirname(DB_PATH)), поэтому
# на проде это /data/avatars и /data/media, а локально — прямо здесь,
# в корне репозитория. Репозиторий публичный, и один `git add .` отправил
# бы чужое лицо в открытую историю необратимо: удалить оттуда файл можно
# только переписав историю всем, кто её клонировал.
#   avatars/     — <user_id>.png
#   media/chat/  — картинки из переписки с ассистентами
#   media/body/  — фотографии прогресса тела
avatars/
media/

# КАДРЫ ВИДЕО УПРАЖНЕНИЙ — кеш фасада (BACKLOG №73). Тот же расчёт
# каталога от dirname(DB_PATH), то есть локально прямо здесь.
# Причина иная, чем у файлов пользователей: это ЧУЖИЕ изображения,
# их 852 по числу роликов, и репозиторий публичный. На проде лежат
# на томе, переживают деплой и в образ не попадают.
previews/

__pycache__/
*.pyc
*.pyo
venv/
.venv/
server.log
server.err
# SSH-утилиты (локальные, не в репу)
ssh_*.py

# Все логи
*.log

# Временные файлы Windows
C*Temp*
*Temp*.log

# Backup-файлы
*.old

# Скриншоты ревью дизайн-миграции (локальные, не в репу)
review_screenshots/